{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/login?eac_google_route=logout"
    },
    {
      "source": "/api/eac-store/products",
      "destination": "/api/auth/login?eac_google_route=store-products"
    },
    {
      "source": "/api/publico/calendario",
      "destination": "/api/auth/login?eac_google_route=public"
    },
    {
      "source": "/api/calendar/google/publication",
      "destination": "/api/auth/login?eac_google_route=publication"
    },
    {
      "source": "/api/calendar/google/oauth/start",
      "destination": "/api/auth/login?eac_google_route=start"
    },
    {
      "source": "/api/calendar/google/oauth/callback",
      "destination": "/api/auth/login?eac_google_route=callback"
    },
    {
      "source": "/api/calendar/google",
      "destination": "/api/auth/login?eac_google_route=events"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
